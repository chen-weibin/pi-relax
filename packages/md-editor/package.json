{
	"name": "@relax/md-editor",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"exports": {
		".": {
			"development": "./src/index.tsx",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "tsdown && mkdir -p dist/styles && cp src/styles/*.css dist/styles/",
		"typecheck": "tsc --noEmit",
		"test": "node --experimental-strip-types --test \"src/**/*.test.ts\""
	},
	"dependencies": {
		"markdown-it": "^14.3.3",
		"prosemirror-commands": "^1.7.2",
		"prosemirror-history": "^1.5.0",
		"prosemirror-inputrules": "^1.7.0",
		"prosemirror-keymap": "^1.2.3",
		"prosemirror-model": "^1.25.11",
		"prosemirror-schema-list": "^1.6.1",
		"prosemirror-state": "^1.4.4",
		"prosemirror-view": "^1.42.3",
		"tailwindcss": "^4.3.3"
	},
	"peerDependencies": {
		"react": "^19.0.0",
		"react-dom": "^19.0.0"
	},
	"devDependencies": {
		"@types/react": "^19.0.0",
		"@types/react-dom": "^19.0.0",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"tsdown": "^0.23.0",
		"typescript": "^5.6.3"
	}
}
